GASCOMP_ADMIN_USERNAME=admin
GASCOMP_ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters
GASCOMP_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Run the migrations in supabase/migrations before enabling the connection.
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_project_key
SUPABASE_SECRET_KEY=sb_secret_replace_with_server_key

# Production subdomain URL for help pages and QR codes. Do not use localhost.
GASCOMP_PUBLIC_BASE_URL=https://support.gascompsuperlock.com

# Optional Care-only local preview. Used by next dev only; ignored in production.
# Keep these unset when testing against a configured staging Supabase database.
GASCOMP_CARE_PREVIEW_URL=
GASCOMP_CARE_PREVIEW_KEY=

# Keep Duoke automation in dry-run mode until every selector is verified on the authorized account.
DUOKE_AUTOREPLY_ENABLED=false
DUOKE_AUTOREPLY_SEND_CLARIFICATIONS=false
# Optional overrides for the local Hermes draft worker (never sends replies).
# The model falls back to GASCOMP_AI_MODEL; the source defaults to ~/.hermes/hermes-agent.
DUOKE_HERMES_MODEL=
DUOKE_HERMES_MODEL_BASE_URL=http://127.0.0.1:11434/v1
DUOKE_HERMES_ROOT=
DUOKE_HERMES_PYTHON=
# Optional full Duoke Obsidian archive (contains Percakapan and Produk).
# Falls back to GASCOMP_AI_SOURCE_VAULT or the saved local AI worker source path.
DUOKE_HERMES_SOURCE_VAULT=
DUOKE_INBOX_URL=https://web.duoke.com/?lang=id#/dk/main
DUOKE_IFRAME_SELECTOR=
DUOKE_CONVERSATION_SELECTOR=
DUOKE_UNREAD_SELECTOR=
DUOKE_CONVERSATION_ID_ATTRIBUTE=
DUOKE_MESSAGE_SELECTOR=
DUOKE_MESSAGE_ID_ATTRIBUTE=
DUOKE_MESSAGE_DIRECTION_ATTRIBUTE=
DUOKE_INCOMING_DIRECTION_VALUES=incoming,customer,buyer,received
DUOKE_PRODUCT_SKU_SELECTOR=
DUOKE_COMPOSER_SELECTOR=
DUOKE_SEND_BUTTON_SELECTOR=

# Optional website assistant. Leave disabled until migration, knowledge, and pilot pass.
GASCOMP_AI_ASSISTANCE_ENABLED=false
# Generate a distinct random value (at least 32 characters); also configure it on the Mac.
GASCOMP_AI_WORKER_TOKEN=

# Optional AI-only local database. Used only by next dev, never production builds.
# Start it with npm run ai:preview-db; leave unset to use the configured Supabase.
GASCOMP_AI_PREVIEW_URL=
GASCOMP_AI_PREVIEW_KEY=

# Mac worker only. These values are never exposed to the customer's browser.
GASCOMP_AI_SITE_URL=https://support.gascompsuperlock.com
GASCOMP_AI_MODEL_BASE_URL=http://127.0.0.1:8000/v1
GASCOMP_AI_MODEL=
# Natural explanations grounded in Obsidian; use exact for the legacy ID selector.
GASCOMP_AI_RESPONSE_MODE=grounded
# Optional overrides; private data stays repository-relative and the knowledge vault
# defaults to ../douke-chat/knowledge/approved/Douke Knowledge Base beside this repository.
DOUKE_VAULT_DIR=
GASCOMP_AI_HERMES_ROOT=
GASCOMP_AI_HERMES_PYTHON=
GASCOMP_AI_VAULT=
# Optional complete scraped Obsidian archive, including Duoke/Percakapan and Duoke/Produk.
# Indexed locally; reusable source passages join the versioned knowledge snapshot.
GASCOMP_AI_SOURCE_VAULT=
GASCOMP_AI_CHROME_CDP_URL=http://127.0.0.1:9222
GASCOMP_AI_BROWSER_HOSTS=support.gascompsuperlock.com
