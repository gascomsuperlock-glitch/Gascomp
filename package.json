{
  "name": "douke-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "duoke:scrape": "scraping/.venv/bin/python -m scraping.duoke.catalog.scrape_duoke",
    "duoke:import": "scraping/.venv/bin/python -m scraping.duoke.catalog.normalize_duoke",
    "duoke:push": "node scripts/duoke/import-duoke-to-supabase.mjs",
    "duoke:login": "scraping/.venv/bin/python -m scraping.duoke.chat.duoke_login",
    "duoke:inspect": "scraping/.venv/bin/python -m scraping.duoke.chat.inspect_duoke",
    "duoke:chat:capture": "scraping/.venv/bin/python -m scraping.duoke.chat.capture_duoke_chats",
    "duoke:knowledge:export": "node scripts/duoke/export-duoke-knowledge.mjs",
    "duoke:knowledge:build": "scraping/.venv/bin/python -m scraping.duoke.knowledge.build_duoke_knowledge",
    "duoke:knowledge:query": "scraping/.venv/bin/python -m scraping.duoke.knowledge.knowledge_engine",
    "duoke:reply:dry-run": "scraping/.venv/bin/python -m scraping.duoke.reply.duoke_auto_reply",
    "duoke:reply:send": "scraping/.venv/bin/python -m scraping.duoke.reply.duoke_auto_reply --send --watch",
    "duoke:stop": "mkdir -p scraping/.private && touch scraping/.private/STOP_AUTOREPLY",
    "duoke:resume": "rm -f scraping/.private/STOP_AUTOREPLY",
    "duoke:test": "scraping/.venv/bin/python -m unittest discover -s scraping/tests -v",
    "warehouse:normalize": "scraping/.venv/bin/python -m scraping.warehouse.normalize_warehouse_xlsx",
    "warehouse:preview": "node scripts/warehouse/import-warehouse-to-supabase.mjs --dry-run",
    "warehouse:push": "node scripts/warehouse/import-warehouse-to-supabase.mjs",
    "brochure:preview": "node scripts/catalog/import-brochure-descriptions.mjs",
    "brochure:push": "node scripts/catalog/import-brochure-descriptions.mjs --apply",
    "supabase:check": "node scripts/supabase/check-supabase-connection.mjs",
    "test": "node --test \"src/**/*.test.mjs\" \"scripts/**/*.test.mjs\"",
    "typecheck": "next typegen && tsc --noEmit",
    "ai:check": "scraping/.venv/bin/python -m scraping.ai_assistance.worker --check",
    "ai:once": "scraping/.venv/bin/python -m scraping.ai_assistance.worker --once",
    "ai:watch": "scraping/.venv/bin/python -m scraping.ai_assistance.worker --watch",
    "ai:probe-links": "scraping/.venv/bin/python -m scraping.ai_assistance.worker --probe-links",
    "ai:services": "node scripts/ai-assistance/launchd.mjs",
    "ai:pilot": "node scripts/ai-assistance/pilot.mjs",
    "ai:preview-db": "node scripts/ai-assistance/preview-database.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@ffmpeg/core": "^0.12.10",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.43.0",
    "mediabunny": "1.56.3",
    "next": "16.3.4",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
